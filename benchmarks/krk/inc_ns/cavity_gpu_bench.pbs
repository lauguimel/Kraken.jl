#!/bin/bash -l
#PBS -N cavity_gpu_ablation
#PBS -l select=1:ncpus=4:ngpus=1:mem=32GB:gpu_id=A100
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -V

# --- SIMPLE cavity GPU ABLATION bench (per-change contribution, A100) --------
# Runs benchmarks/krk/inc_ns/cavity_gpu_bench.jl: one legacy CPU reference at
# 512^2 Re=1000, then the cumulative GPU ablation ladder
#   C0 legacy -> C1 +norm_stride=25 -> C2 +fixed MG cycles (3/1)
#   -> C3 +CUDA graph -> C4 +mixed precision (pressure+momentum).
# Per config: wall time, outer iters, converged?, speed-up vs CPU ref, max-rel
# u/v/p parity vs CPU ref (<1e-3), Ghia 1982 centreline error %, and GPU
# utilization. The BENCH ITSELF starts/stops a background
#   nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader -l 1
# sampler around each config's TIMED SOLVE WINDOW (per-config logs
# gpu_util_<config>_N<N>.log in $WORKDIR), so the mean/peak in the table cover
# the solve only — no global job-wide sampler here.
#
# WALLTIME BUDGET (anchors: CPU 512^2 legacy = 3687 s, GPU 512^2 legacy = 865 s)
#   CPU ref ~62 min; C0 ~15 min; C1..C4 monotonically less (est. 35-50 min
#   total); JIT/instantiate/warmups ~10 min  =>  ~2 h. 4 h gives 2x margin and
#   room for the optional 1024^2 best-config run.
#
# OPTIONS (export before qsub, passed through by #PBS -V, e.g.
#   qsub -v CAVITY_BENCH_1024=1 cavity_gpu_bench.pbs):
#   CAVITY_BENCH_1024=1     add a 1024^2 GPU-only run of the best config
#                           (C4 -> C3 -> C2 fallback). No CPU 1024^2.
#   CAVITY_BENCH_1024_C0=1  also run C0 at 1024^2 for contrast (~2 h alone:
#                           only with an extended walltime).

WORKDIR=$HOME/kraken_poisson_gpu_bench
cd $WORKDIR

echo "========================================"
echo "Job: $PBS_JOBID"
echo "Node: $(hostname)"
echo "GPU:  $(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null || echo 'N/A')"
echo "Start: $(date)"
echo "========================================"

export PATH=$HOME/.juliaup/bin:$PATH
export JULIA_CUDA_USE_COMPAT=false

nvidia-smi --query-gpu=name,memory.total,driver_version --format=csv,noheader

julia --project=. -e 'using Pkg; Pkg.instantiate(); using CUDA; CUDA.versioninfo()' 2>&1

echo "=== SIMPLE cavity GPU ablation bench (C0->C4 vs legacy CPU ref) ==="
julia --project=. benchmarks/krk/inc_ns/cavity_gpu_bench.jl 2>&1
EXIT_CODE=$?

echo "========================================"
echo "Per-config GPU utilization logs (solve windows; summarised in the table):"
ls -la "$WORKDIR"/gpu_util_*.log 2>/dev/null || echo "  (no per-config logs found)"
echo "========================================"
echo "End: $(date)  exit=$EXIT_CODE"
echo "========================================"
exit $EXIT_CODE
