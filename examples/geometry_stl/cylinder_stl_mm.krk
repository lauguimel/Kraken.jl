# M-GEO-4 physical-units STL case.
# Convention: L_ref and R_LU are both the cylinder radius.
# The bundled STL radius is 0.2 mm, so R_LU=4 gives dx_real=0.05 mm
# and the parser bridge applies STL scale=20.0.

Simulation mgeo4_stl_cylinder_mm D2Q9

Units { length = mm  L_ref = 0.2  R_LU = 4  Re = 1.0  scaling = acoustic }

Domain L = 80 x 20  N = 80 x 20
Physics nu = auto

Obstacle cyl wall=libb stl(file = "examples/geometry_stl/cylinder.stl", z_slice = 0.5)

Boundary west  velocity(ux = u_LU, uy = 0)
Boundary east  pressure(rho = 1.0)
Boundary south wall
Boundary north wall

Run 30 steps
