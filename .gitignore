Manifest.toml
.vscode/
.DS_Store
**/.DS_Store
*.jl.cov
*.jl.*.cov
*.jl.mem
deps/build.log
docs/build/
# Vitepress npm dependencies. docs/make.jl copies the DocumenterVitepress
# template package.json in and runs `npm install` itself, so this directory is
# rebuilt on every docs build, locally and in CI. It was tracked between
# 2026-09-14 and this commit (8210 files) by an accidental merge.
docs/node_modules/

# Local outputs and intermediate results
output/
# results/ at root only (top-level), NOT benchmarks/results/ which is
# a versioned sync point for the doc figures.
/results/

# EHD Tc sweep output: one 250 kB CSV per T value per run, so new sweeps are
# ignored by default. Runs kept as validation evidence are already tracked
# (see benchmarks/results/ehd/README.md); promote a new one with `git add -f`.
benchmarks/results/ehd/tc_sweep_*.csv
benchmarks/results/ehd/tc_sweep_*.md

