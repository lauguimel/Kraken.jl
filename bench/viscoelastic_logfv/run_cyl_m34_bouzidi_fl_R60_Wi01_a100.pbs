#!/bin/bash -l
#PBS -N M34_bouzidi_fl_R60_Wi01
#PBS -l select=1:ncpus=8:ngpus=1:mem=64GB:gpu_id=A100
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -m ae

# M34 — Kraken viscoelastic R=60 Wi=0.1 NaN-elimination test under
# wall_bc=:bouzidi_fl_twopass.
#
# Single case parameters:
#   R = 60 (LU)
#   Wi = 0.1
#   beta = 0.59 (rheoTool match)
#   Re_R = 1
#   bsd_fraction = 1.0
#   L_up = L_down = 15 (Kraken canonical)
#   Geometry: qwall (no embedded)
#   Advection scheme: rusanov (M29b production)
#   wall_bc: :bouzidi_fl_twopass (M34 NEW)
#
# Acceptance criterion (mandate §M34 G4 gate, NaN suppression):
#   * R=60 Wi=0.1 runs cleanly to KRAKEN_MAX_STEPS_BASE (100k) without NaN.
#     Under :halfwayBB the run NaN'd at step ~36k; :bouzidi_fl_twopass should
#     suppress the staircase-induced instability and reach 100k.
#
# If R=60 Wi=0.1 still NaN's under :bouzidi_fl_twopass, the BC is NOT the
# primary suspect for the R=60 NaN, and M34 verdict needs revisiting.
#
# Diagnostic output: KRAKEN_SAVE_FIELDS=1 persists (ux, uy, tauxx, tauxy,
# tauyy, is_solid, rho) for wall decomposition analysis.

set -euo pipefail

cd "$PBS_O_WORKDIR"

export PATH="$HOME/.juliaup/bin:$PATH"
export JULIA_CUDA_USE_COMPAT=false
export JULIA_PKG_PRECOMPILE_AUTO=0
export JULIA_DEPOT_PATH="${PBS_O_WORKDIR}/../julia_depot:$HOME/.julia"
mkdir -p "${PBS_O_WORKDIR}/../julia_depot"

export KRAKEN_BACKEND="cuda"
export KRAKEN_FT="float64"

# Single case.
export KRAKEN_BETA_LIST="0.59"
export KRAKEN_WI_LIST="0.1"
export KRAKEN_RE_LIST="1.0"
export KRAKEN_R_LIST="60"
export KRAKEN_BSD_LIST="1.0"
export KRAKEN_L_UP_LIST="15.0"
export KRAKEN_L_DOWN_LIST="15.0"
export KRAKEN_EMBEDDED_GRADIENT="0"
export KRAKEN_EMBEDDED_ADVECTION="0"
export KRAKEN_EMBEDDED_FORCE="0"
export KRAKEN_EMBEDDED_DRAG="0"
export KRAKEN_EMBEDDED_GEOMETRY="qwall"

# M29b production scheme.
export KRAKEN_ADVECTION_SCHEME="rusanov"
# M34 NEW: Bouzidi-FL two-pass wall BC.
export KRAKEN_WALL_BC="bouzidi_fl_twopass"

export KRAKEN_U_MEAN="0.005"
export KRAKEN_MAX_STEPS_BASE="100000"
export KRAKEN_AVG_WINDOW_FRAC="0.2"
export KRAKEN_SAVE_FIELDS="1"
export KRAKEN_OUTPUT_DIR="${KRAKEN_OUTPUT_DIR:-tmp/m34_bouzidi_fl_R60_Wi01/${PBS_JOBID:-manual}}"

nvidia-smi || true

if [ "${KRAKEN_SKIP_PKG:-0}" != "1" ]; then
    julia --project=. -e 'using Pkg; Pkg.resolve(); Pkg.instantiate(); Pkg.precompile()'
fi

mkdir -p "$KRAKEN_OUTPUT_DIR"
echo "=== cyl_m34_bouzidi_fl_R60_Wi01 starting at $(date) ==="
echo "Target: R=60 Wi=0.1 beta=0.59 Re=1 bsd=1.0 (qwall, no embedded)"
echo "Scheme: $KRAKEN_ADVECTION_SCHEME"
echo "Wall BC: $KRAKEN_WALL_BC (M34 NEW)"
echo "Output dir: $KRAKEN_OUTPUT_DIR"
echo "Save fields: $KRAKEN_SAVE_FIELDS"
echo "Gate: NaN suppression vs halfwayBB step ~36k baseline"

julia --project=. bench/viscoelastic_logfv/run_cyl_bigsweep_v2_2d.jl

echo "=== cyl_m34_bouzidi_fl_R60_Wi01 done at $(date) ==="
ls -la "$KRAKEN_OUTPUT_DIR"
