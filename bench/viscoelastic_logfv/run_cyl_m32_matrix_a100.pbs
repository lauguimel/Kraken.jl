#!/bin/bash -l
#PBS -N M32_matrix
#PBS -l select=1:ncpus=8:ngpus=1:mem=64GB:gpu_id=A100
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -m ae

# M32 Phase 2 — Kraken viscoelastic matrix R x Wi for canonical setup
#
# 4 cases: R in {30, 60} x Wi in {0.1, 1.0} at beta=0.59, Re=1,
# bsd_fraction=1.0, advection scheme :rusanov (M29b production).
#
# Purpose: separate the resolution confounder (R) from the physics
# confounder (Wi) in the Kraken-vs-rheoTool gap. Phase 1 audit
# (bench/viscoelastic_audit/M32_PHASE1_SETUP_AUDIT_VERDICT.md) showed
# the canonical setup has HARD mismatches (L_down, BSD, staircase)
# that are independent of Wi; the matrix isolates how much of the
# residual gap is (a) under-resolved boundary layer (R=30 staircase
# blob is ~0.033R thick vs rheoTool 0.005R), (b) finite-Wi polymer
# pipeline error (M29 closed 56% with MUSCL-superbee; rusanov is
# the production default and the reference for this matrix).
#
# Matrix:
#   R     = {30, 60}        (resolution sweep)
#   Wi    = {0.1, 1.0}      (low-Wi / high-Wi)
#   beta  = 0.59            (rheoTool match)
#   Re_R  = 1               (rheoTool match)
#   bsd   = 1.0             (M29b production; rT uses coupling not BSD,
#                            documented as H2 in Phase 1 audit)
#   L_up = L_down = 15R     (Kraken canonical, NOT rT 20R+60R; H1)
#   Geometry: qwall (no embedded force/advection/drag — M29b production)
#   Advection: rusanov (M29b production default)
#
# R=60 stability risk (commented gate):
#   The Phase 1 R-sweep on Metal F32 showed R=60 Wi=1 NaN'd. F64 CUDA
#   may extend stability (F64 round-off at log_spd is 1e-16 vs F32
#   1e-7, more headroom for the SPD eigenvalue floor) but cannot
#   guarantee convergence at this Wi.
#
#   Failure mode to watch for: step-0 NaN at R=60 (M28e observed this
#   at R=60/80 on F64; root cause likely an init/psi->C exponentiation
#   stability issue, NOT a max_steps issue — see engineer.md
#   2026-05-19 entry).
#
#   If R=60 Wi=1.0 NaN's, the verdict is "R-sweep cannot reach R=60 in
#   this regime, port confined to R <= 40". R=60 Wi=0.1 may still
#   succeed (lower elastic stress), which would validate that the
#   resolution path works at moderate Wi. The matrix is built so each
#   case fails independently — try/catch around DomainError is built
#   into run_cyl_bigsweep_v2_2d.jl.
#
# Diagnostic output: KRAKEN_SAVE_FIELDS=1 persists (ux, uy, tauxx,
# tauxy, tauyy, is_solid, rho) per case for wall decomposition
# (M30 schema extension). ~4 MB per case at R=30, ~16 MB per case
# at R=60 (4x more cells).

set -euo pipefail

cd "$PBS_O_WORKDIR"

export PATH="$HOME/.juliaup/bin:$PATH"
export JULIA_CUDA_USE_COMPAT=false
export JULIA_PKG_PRECOMPILE_AUTO=0
export JULIA_DEPOT_PATH="${PBS_O_WORKDIR}/../julia_depot:$HOME/.julia"
mkdir -p "${PBS_O_WORKDIR}/../julia_depot"

export KRAKEN_BACKEND="cuda"
export KRAKEN_FT="float64"

# Matrix: 2 R x 2 Wi = 4 cases. The bench loops over BETA x WI x RE x
# R x BSD x GEOM_CONFIGS x EMBEDDED_CONFIGS (see run_cyl_bigsweep_v2_2d.jl
# lines 411-413). With single-valued lists for everything else, this
# expands to exactly 2*2 = 4 cases.
export KRAKEN_BETA_LIST="0.59"
export KRAKEN_WI_LIST="0.1,1.0"
export KRAKEN_RE_LIST="1.0"
export KRAKEN_R_LIST="30,60"
export KRAKEN_BSD_LIST="1.0"
export KRAKEN_L_UP_LIST="15.0"
export KRAKEN_L_DOWN_LIST="15.0"
export KRAKEN_EMBEDDED_GRADIENT="0"
export KRAKEN_EMBEDDED_ADVECTION="0"
export KRAKEN_EMBEDDED_FORCE="0"
export KRAKEN_EMBEDDED_DRAG="0"
export KRAKEN_EMBEDDED_GEOMETRY="qwall"

# M29b production scheme.
export KRAKEN_ADVECTION_SCHEME="rusanov"

export KRAKEN_U_MEAN="0.005"
export KRAKEN_MAX_STEPS_BASE="100000"
export KRAKEN_AVG_WINDOW_FRAC="0.2"
export KRAKEN_SAVE_FIELDS="1"
export KRAKEN_OUTPUT_DIR="${KRAKEN_OUTPUT_DIR:-tmp/m32_matrix/${PBS_JOBID:-manual}}"

nvidia-smi || true

if [ "${KRAKEN_SKIP_PKG:-0}" != "1" ]; then
    julia --project=. -e 'using Pkg; Pkg.resolve(); Pkg.instantiate(); Pkg.precompile()'
fi

mkdir -p "$KRAKEN_OUTPUT_DIR"
echo "=== cyl_m32_matrix starting at $(date) ==="
echo "Matrix: R in {30,60} x Wi in {0.1,1.0} = 4 cases"
echo "Fixed: beta=0.59 Re=1 bsd=1.0 (qwall, no embedded)"
echo "Scheme: $KRAKEN_ADVECTION_SCHEME (M29b production)"
echo "Output dir: $KRAKEN_OUTPUT_DIR"
echo "Save fields: $KRAKEN_SAVE_FIELDS (includes rho — M30 schema extension)"
echo "Caveat: R=60 Wi=1.0 may NaN (F32 Phase 1 result; F64 not guaranteed)"

julia --project=. bench/viscoelastic_logfv/run_cyl_bigsweep_v2_2d.jl

echo "=== cyl_m32_matrix done at $(date) ==="
ls -la "$KRAKEN_OUTPUT_DIR"
