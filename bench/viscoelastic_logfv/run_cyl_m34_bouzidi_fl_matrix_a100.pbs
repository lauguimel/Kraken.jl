#!/bin/bash -l
#PBS -N M34_bouzidi_fl_matrix
#PBS -l select=1:ncpus=8:ngpus=1:mem=64GB:gpu_id=A100
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -m ae

# M34 — Kraken viscoelastic matrix R x Wi for wall_bc=:bouzidi_fl_twopass
#
# 4 cases: R in {30, 40} x Wi in {0.1, 1.0} at beta=0.59, Re=1,
# bsd_fraction=1.0, advection scheme :rusanov, wall_bc=:bouzidi_fl_twopass.
#
# Purpose (M34 G4 BC gate):
#   M32 closed the polymer-scheme locus (β-sweep R-invariant at Wi=1) but left a
#   residual −7.3 % Wi=1 Cd gap and an R=60 NaN at Wi=0.1 under the default
#   wall BC (:halfwayBB). M34 implementation (committed f380157a) ports the
#   Bouzidi-FL two-pass linear-interpolation wall BC. This matrix is the
#   empirical closure step.
#
# Matrix:
#   R     = {30, 40}        (resolution sweep; R=60 in companion R60 PBS)
#   Wi    = {0.1, 1.0}      (low-Wi / high-Wi)
#   beta  = 0.59            (rheoTool match)
#   Re_R  = 1               (rheoTool match)
#   bsd   = 1.0             (M29b production)
#   L_up = L_down = 15R     (Kraken canonical)
#   Geometry: qwall (no embedded force/advection/drag)
#   Advection: rusanov (M29b production default)
#   wall_bc:  :bouzidi_fl_twopass (M34 NEW)
#
# Acceptance criterion (mandate §M34 G4 gate):
#   * R=30 Wi=1   Cd in [118, 122]                (CLOSE the −7.3 % gap)
#   * R=30 Wi=0.1 Cd within 1 % of rheoTool 130.43
#   * R=40 Wi=1   reproduces R=30 within ±0.5 %    (BC R-invariant)
#   * R=40 Wi=0.1 reproduces R=30 within ±0.5 %
#
# Diagnostic output: KRAKEN_SAVE_FIELDS=1 persists (ux, uy, tauxx, tauxy,
# tauyy, is_solid, rho) per case for wall decomposition.

set -euo pipefail

cd "$PBS_O_WORKDIR"

export PATH="$HOME/.juliaup/bin:$PATH"
export JULIA_CUDA_USE_COMPAT=false
export JULIA_PKG_PRECOMPILE_AUTO=0
export JULIA_DEPOT_PATH="${PBS_O_WORKDIR}/../julia_depot:$HOME/.julia"
mkdir -p "${PBS_O_WORKDIR}/../julia_depot"

export KRAKEN_BACKEND="cuda"
export KRAKEN_FT="float64"

# Matrix: 2 R x 2 Wi = 4 cases.
export KRAKEN_BETA_LIST="0.59"
export KRAKEN_WI_LIST="0.1,1.0"
export KRAKEN_RE_LIST="1.0"
export KRAKEN_R_LIST="30,40"
export KRAKEN_BSD_LIST="1.0"
export KRAKEN_L_UP_LIST="15.0"
export KRAKEN_L_DOWN_LIST="15.0"
export KRAKEN_EMBEDDED_GRADIENT="0"
export KRAKEN_EMBEDDED_ADVECTION="0"
export KRAKEN_EMBEDDED_FORCE="0"
export KRAKEN_EMBEDDED_DRAG="0"
export KRAKEN_EMBEDDED_GEOMETRY="qwall"

# M29b production scheme.
export KRAKEN_ADVECTION_SCHEME="rusanov"
# M34 NEW: Bouzidi-FL two-pass wall BC.
export KRAKEN_WALL_BC="bouzidi_fl_twopass"

export KRAKEN_U_MEAN="0.005"
export KRAKEN_MAX_STEPS_BASE="100000"
export KRAKEN_AVG_WINDOW_FRAC="0.2"
export KRAKEN_SAVE_FIELDS="1"
export KRAKEN_OUTPUT_DIR="${KRAKEN_OUTPUT_DIR:-tmp/m34_bouzidi_fl_matrix/${PBS_JOBID:-manual}}"

nvidia-smi || true

if [ "${KRAKEN_SKIP_PKG:-0}" != "1" ]; then
    julia --project=. -e 'using Pkg; Pkg.resolve(); Pkg.instantiate(); Pkg.precompile()'
fi

mkdir -p "$KRAKEN_OUTPUT_DIR"
echo "=== cyl_m34_bouzidi_fl_matrix starting at $(date) ==="
echo "Matrix: R in {30,40} x Wi in {0.1,1.0} = 4 cases"
echo "Fixed: beta=0.59 Re=1 bsd=1.0 (qwall, no embedded)"
echo "Scheme: $KRAKEN_ADVECTION_SCHEME"
echo "Wall BC: $KRAKEN_WALL_BC (M34 NEW)"
echo "Output dir: $KRAKEN_OUTPUT_DIR"
echo "Save fields: $KRAKEN_SAVE_FIELDS (includes rho)"
echo "Gate: G4 BC gate — see mandate §M34"

julia --project=. bench/viscoelastic_logfv/run_cyl_bigsweep_v2_2d.jl

echo "=== cyl_m34_bouzidi_fl_matrix done at $(date) ==="
ls -la "$KRAKEN_OUTPUT_DIR"
