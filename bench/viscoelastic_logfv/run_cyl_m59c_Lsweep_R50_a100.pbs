#!/bin/bash -l
#PBS -N M59C_LSWEEP_R50
#PBS -l select=1:ncpus=8:ngpus=1:mem=64GB:gpu_id=A100
#PBS -l walltime=02:30:00
#PBS -j oe
#PBS -m ae

# M59-C — Domain length sweep at R=50 F64, three flow regimes.
#
# Context: M59 (job 21977509) + M59-B (job 22027412) established the F64
# U-shape is real (R=10/30/50 Cd = 114.53 / 118.10 / 115.75 in F64 CUDA).
# Effect B candidates rejected: polymer cap, tconv, F32 precision.
# Remaining open candidates: domain length, FVFD wall stencil at R=50.
#
# This sweep: L_up = L_down in {15, 20, 30} R-multiples, R=50 fixed.
# Three Wi/beta regimes to discriminate polymer effects from Newt-like:
#   (a) beta=0.59 Wi=0.1 : low-Wi polymer (anchored by L0 V&V baseline)
#   (b) beta=0.59 Wi=1.0 : full-Wi polymer (M59 baseline 115.75 at L=15)
#   (c) beta=1.0  Wi=1.0 : Newtonian (polymer dormant; bit-equivalent to
#                          real Newt per M41/M46)
#
# Discriminators:
#   - If Cd shifts with L in (a) AND (b) AND (c) -> Newt-like outlet/ZouHe
#     wake effect, NOT polymer-specific.
#   - If Cd shifts with L in (a)/(b) but flat in (c) -> polymer-specific
#     coupling to outlet (e.g. polymer stress at outflow).
#   - If Cd flat across all L -> domain length REFUTED as effect B,
#     triage FVFD wall stencil next.
#
# Setup: matches M48 fixture (eg=ea=ef=ed=0 qwall halfwayBB muscl_superbee
# BSD=1 Re=1 cap=64), R=50 fixed, F64.
#
# Cost estimate per case (A100 R=50 300k F64):
#   L=15 ~5 min, L=20 ~7 min, L=30 ~10 min
#   3 regimes x 3 L = 9 cases ~ 66 min + precompile. Walltime 2.5h budget.

set -euo pipefail

cd "$PBS_O_WORKDIR"

export PATH="$HOME/.juliaup/bin:$PATH"
export JULIA_CUDA_USE_COMPAT=false
export JULIA_PKG_PRECOMPILE_AUTO=0
export JULIA_DEPOT_PATH="${PBS_O_WORKDIR}/../julia_depot:$HOME/.julia"
mkdir -p "${PBS_O_WORKDIR}/../julia_depot"

export KRAKEN_BACKEND="cuda"
export KRAKEN_FT="float64"

# Common setup (M48 fixture).
export KRAKEN_R_LIST="50"
export KRAKEN_RE_LIST="1.0"
export KRAKEN_BSD_LIST="1.0"
export KRAKEN_EMBEDDED_GRADIENT="0"
export KRAKEN_EMBEDDED_ADVECTION="0"
export KRAKEN_EMBEDDED_FORCE="0"
export KRAKEN_EMBEDDED_DRAG="0"
export KRAKEN_EMBEDDED_GEOMETRY="qwall"
export KRAKEN_ADVECTION_SCHEME="muscl_superbee"
export KRAKEN_WALL_BC="halfwayBB"
export KRAKEN_U_MEAN="0.005"
export KRAKEN_AVG_WINDOW_FRAC="0.2"
export KRAKEN_SAVE_FIELDS="1"
export KRAKEN_MAX_STEPS_BASE="300000"

# Domain length sweep (paired L_up=L_down).
export KRAKEN_L_UP_LIST="15.0,20.0,30.0"
export KRAKEN_L_DOWN_LIST="15.0,20.0,30.0"

nvidia-smi || true

if [ "${KRAKEN_SKIP_PKG:-0}" != "1" ]; then
    julia --project=. -e 'using Pkg; Pkg.resolve(); Pkg.instantiate(); Pkg.precompile()'
fi

ROOT_OUT="tmp/m59c_Lsweep_R50/${PBS_JOBID:-manual}"
mkdir -p "$ROOT_OUT"

echo "=== M59-C R=50 L sweep, three regimes, starting at $(date) ==="

# Regime (a) + (b): beta=0.59, Wi in {0.1, 1.0}, 6 cases
echo ""
echo "--- Polymer beta=0.59, Wi in {0.1, 1.0}, L in {15,20,30}R (6 cases) ---"
export KRAKEN_BETA_LIST="0.59"
export KRAKEN_WI_LIST="0.1,1.0"
export KRAKEN_OUTPUT_DIR="${ROOT_OUT}/poly_beta059"
mkdir -p "$KRAKEN_OUTPUT_DIR"
julia --project=. bench/viscoelastic_logfv/run_cyl_bigsweep_v2_2d.jl

# Regime (c): beta=1.0 placeholder Newtonian, Wi=1.0, 3 cases
echo ""
echo "--- Newtonian beta=1.0 (polymer dormant), L in {15,20,30}R (3 cases) ---"
export KRAKEN_BETA_LIST="1.0"
export KRAKEN_WI_LIST="1.0"
export KRAKEN_OUTPUT_DIR="${ROOT_OUT}/newt_beta100"
mkdir -p "$KRAKEN_OUTPUT_DIR"
julia --project=. bench/viscoelastic_logfv/run_cyl_bigsweep_v2_2d.jl

echo "=== M59-C done at $(date) ==="
echo ""
echo "Cd matrix (Cd_kraken, col 26):"
for d in poly_beta059 newt_beta100; do
    for f in "${ROOT_OUT}/${d}"/cyl_bigsweep_v2_*.csv; do
        [ -e "$f" ] || continue
        cd_val=$(awk -F, 'NR==2 {print $26}' "$f")
        echo "  $(basename "$f" .csv) : Cd=$cd_val"
    done
done
