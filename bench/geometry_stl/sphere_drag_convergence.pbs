#!/bin/bash -l
#PBS -N kraken_sphere_drag_conv
#PBS -l select=1:ncpus=4:ngpus=1:mem=96GB:gpu_id=A100
#PBS -l walltime=06:00:00
#PBS -j oe
#PBS -m n
#
# M-GEO-7(b): 3D STL sphere drag convergence toward free-stream Clift Cd~2.6
# (Re=20), CUDA Float64. Smoke (R=8) first, then the R=16 blockage sweep.
#
# Usage (from the Aqua head node):
#   cd ~/Kraken.jl-v0.3-campaign
#   qsub bench/geometry_stl/sphere_drag_convergence.pbs
#
# Output: kraken_sphere_drag_conv.o<jobid> + bench/geometry_stl/sphere_drag_conv.csv
cd $PBS_O_WORKDIR

export PATH="$HOME/.juliaup/bin:$PATH"
export JULIA_CUDA_USE_COMPAT=false
export JULIA_NUM_THREADS=4

echo "== nvidia-smi =="
nvidia-smi || { echo "ERROR: GPU not available"; exit 1; }
echo ""
echo "== julia --version =="; julia --version; echo ""

echo "== instantiate (idempotent) =="
julia --project=. -e 'using Pkg; Pkg.instantiate()' || { echo "ERROR: instantiate failed"; exit 1; }

echo "== run sphere drag convergence =="
julia --project=. bench/geometry_stl/sphere_drag_convergence.jl 2>&1 | tee bench/geometry_stl/sphere_drag_conv.log

echo "== CSV result =="
cat bench/geometry_stl/sphere_drag_conv.csv
