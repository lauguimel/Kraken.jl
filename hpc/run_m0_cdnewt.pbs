#!/bin/bash -l
#PBS -N krk_m0_cdnewt
#PBS -l select=1:ncpus=8:ngpus=1:mem=32GB:gpu_id=H100
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -m ae

cd $PBS_O_WORKDIR

export PATH="$HOME/.juliaup/bin:$PATH"
export JULIA_CUDA_USE_COMPAT=false

nvidia-smi || { echo "ERROR: GPU not available"; exit 1; }
julia --project=. -e 'using Pkg; Pkg.resolve(); Pkg.instantiate(); Pkg.precompile()'

mkdir -p results
echo "=== M0 Cd_Newt convergence R={30,60,120} β=N/A F64 at $(date) ==="
julia --project=. hpc/m0_cdnewt_convergence.jl 2>&1 \
    | tee results/m0_cdnewt_convergence.txt
echo "=== Done at $(date) ==="
