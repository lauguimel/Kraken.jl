#!/bin/bash -l
#PBS -N krk_step_matrix
#PBS -l select=1:ncpus=8:ngpus=1:mem=48GB:gpu_id=H100
#PBS -l walltime=06:00:00
#PBS -j oe
#PBS -m ae

cd $PBS_O_WORKDIR

export PATH="$HOME/.juliaup/bin:$PATH"
export JULIA_CUDA_USE_COMPAT=false
export JULIA_PKG_PRECOMPILE_AUTO=0
export JULIA_DEPOT_PATH="${PBS_O_WORKDIR}/../julia_depot:$HOME/.julia"
mkdir -p "${PBS_O_WORKDIR}/../julia_depot"

export KRAKEN_BACKEND="${KRAKEN_BACKEND:-cuda}"
export KRAKEN_GEOMETRIES="${KRAKEN_GEOMETRIES:-contraction}"
export KRAKEN_HOUT="${KRAKEN_HOUT:-8}"
export KRAKEN_CONTRACTION_RATIO="${KRAKEN_CONTRACTION_RATIO:-4}"
export KRAKEN_L_UP="${KRAKEN_L_UP:-8}"
export KRAKEN_L_DOWN="${KRAKEN_L_DOWN:-24}"
export KRAKEN_BFS_HIN="${KRAKEN_BFS_HIN:-${KRAKEN_HOUT}}"
export KRAKEN_BFS_EXPANSION_RATIO="${KRAKEN_BFS_EXPANSION_RATIO:-2}"
export KRAKEN_BFS_L_UP="${KRAKEN_BFS_L_UP:-${KRAKEN_L_UP}}"
export KRAKEN_BFS_L_DOWN="${KRAKEN_BFS_L_DOWN:-${KRAKEN_L_DOWN}}"
export KRAKEN_U_REF_MEAN="${KRAKEN_U_REF_MEAN:-0.005}"
export KRAKEN_RE="${KRAKEN_RE:-1.0}"
export KRAKEN_BETA="${KRAKEN_BETA:-0.59}"
export KRAKEN_WI_LIST="${KRAKEN_WI_LIST:-0.05,0.1,0.2}"
export KRAKEN_MODELS="${KRAKEN_MODELS:-direct}"
export KRAKEN_POLYMER_BCS="${KRAKEN_POLYMER_BCS:-none,cnebb}"
export KRAKEN_HERMITE_SOURCE_MODES="${KRAKEN_HERMITE_SOURCE_MODES:-liu_direct,ce_corrected}"
export KRAKEN_MAGIC_LIST="${KRAKEN_MAGIC_LIST:-1e-6}"
export KRAKEN_STEPS_PER_H="${KRAKEN_STEPS_PER_H:-1000}"
export KRAKEN_AVG_DIVISOR="${KRAKEN_AVG_DIVISOR:-5}"
export KRAKEN_RESULTS_DIR="${KRAKEN_RESULTS_DIR:-results/step_geometry_isolation_${PBS_JOBID:-local}}"

nvidia-smi || { echo "ERROR: GPU not available"; exit 1; }
if [ "${KRAKEN_SKIP_PKG:-0}" != "1" ]; then
    julia --project=. -e 'using Pkg; Pkg.resolve(); Pkg.instantiate(); Pkg.precompile()'
fi

mkdir -p results
echo "=== Step-geometry isolation at $(date) ==="
julia --project=. hpc/contraction_step_isolation.jl 2>&1 \
    | tee "results/step_geometry_isolation_${PBS_JOBID:-local}.txt"
echo "=== Done at $(date) ==="
