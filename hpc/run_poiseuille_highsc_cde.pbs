#!/bin/bash -l
#PBS -N krk_pois_cde
#PBS -l select=1:ncpus=8:ngpus=1:mem=32GB
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -m ae

cd $PBS_O_WORKDIR

export PATH="$HOME/.juliaup/bin:$PATH"
export JULIA_CUDA_USE_COMPAT=false
export JULIA_PKG_PRECOMPILE_AUTO=0
export JULIA_DEPOT_PATH="${PBS_O_WORKDIR}/../julia_depot:$HOME/.julia"
mkdir -p "${PBS_O_WORKDIR}/../julia_depot"

export KRAKEN_BACKEND="${KRAKEN_BACKEND:-cuda}"
export KRAKEN_R="${KRAKEN_R:-30}"
export KRAKEN_U_MEAN="${KRAKEN_U_MEAN:-0.005}"
export KRAKEN_BETA="${KRAKEN_BETA:-0.59}"
export KRAKEN_WI="${KRAKEN_WI:-0.1}"
export KRAKEN_STEPS="${KRAKEN_STEPS:-120000}"
export KRAKEN_COLLISIONS="${KRAKEN_COLLISIONS:-trt,liu_eq26}"
export KRAKEN_CNEBB_PHI_MODES="${KRAKEN_CNEBB_PHI_MODES:-pre_opp}"
export KRAKEN_SC_LIST="${KRAKEN_SC_LIST:-10000}"
export KRAKEN_CONFORMATION_MAGIC="${KRAKEN_CONFORMATION_MAGIC:-2.5e-7}"

nvidia-smi || { echo "ERROR: GPU not available"; exit 1; }
if [ "${KRAKEN_SKIP_PKG:-0}" != "1" ]; then
    julia --project=. -e 'using Pkg; Pkg.resolve(); Pkg.instantiate(); Pkg.precompile()'
fi

mkdir -p results
echo "=== Poiseuille high-Sc CDE isolation at $(date) ==="
julia --project=. hpc/poiseuille_highsc_cde_isolation.jl 2>&1 \
    | tee results/poiseuille_highsc_cde.txt
echo "=== Done at $(date) ==="
