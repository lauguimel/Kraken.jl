#!/bin/bash -l
#PBS -N krk_cart_newt
#PBS -l select=1:ncpus=8:ngpus=1:mem=48GB
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -m ae

cd $PBS_O_WORKDIR

export PATH="$HOME/.juliaup/bin:$PATH"
export JULIA_CUDA_USE_COMPAT=false
export JULIA_PKG_PRECOMPILE_AUTO=0
export JULIA_DEPOT_PATH="${PBS_O_WORKDIR}/../julia_depot:$HOME/.julia"
mkdir -p "${PBS_O_WORKDIR}/../julia_depot"

export KRAKEN_BACKEND="${KRAKEN_BACKEND:-cuda}"
export KRAKEN_SIDE="${KRAKEN_SIDE:-40}"
export KRAKEN_H="${KRAKEN_H:-80}"
export KRAKEN_L_UP="${KRAKEN_L_UP:-7}"
export KRAKEN_L_DOWN="${KRAKEN_L_DOWN:-8}"
export KRAKEN_U_REF_MEAN="${KRAKEN_U_REF_MEAN:-0.02}"
export KRAKEN_RE="${KRAKEN_RE:-1.0}"
export KRAKEN_BETA="${KRAKEN_BETA:-0.59}"
export KRAKEN_WI="${KRAKEN_WI:-0.001}"
export KRAKEN_STEPS="${KRAKEN_STEPS:-30000}"
export KRAKEN_AVG_DIVISOR="${KRAKEN_AVG_DIVISOR:-5}"
export KRAKEN_DRAG_STRIDE="${KRAKEN_DRAG_STRIDE:-50}"
export KRAKEN_MOMENTUM_EXCHANGE_MODE="${KRAKEN_MOMENTUM_EXCHANGE_MODE:-mei_reconstruct}"
export KRAKEN_FORCE_LINK_MODE="${KRAKEN_FORCE_LINK_MODE:-cardinal}"
export KRAKEN_SOLVENT_MAGIC="${KRAKEN_SOLVENT_MAGIC:-0.1875}"
export KRAKEN_CONFORMATION_MAGIC="${KRAKEN_CONFORMATION_MAGIC:-0.25}"
export KRAKEN_CONFORMATION_DIVERGENCE_MODE="${KRAKEN_CONFORMATION_DIVERGENCE_MODE:-trace_free}"
export KRAKEN_HERMITE_SOURCE_MODE="${KRAKEN_HERMITE_SOURCE_MODE:-ce_corrected}"
export KRAKEN_SOURCE_SCALE_DYNAMICS="${KRAKEN_SOURCE_SCALE_DYNAMICS:-1.0}"
export KRAKEN_POLYMER_BCS="${KRAKEN_POLYMER_BCS:-cnebb,extrap_eq}"

nvidia-smi || { echo "ERROR: GPU not available"; exit 1; }
if [ "${KRAKEN_SKIP_PKG:-0}" != "1" ]; then
    julia --project=. -e 'using Pkg; Pkg.resolve(); Pkg.instantiate(); Pkg.precompile()'
fi

mkdir -p results
echo "=== Cartesian obstacle Newtonian-limit canary at $(date) ==="
julia --project=. hpc/cartesian_newtonian_limit.jl 2>&1 \
    | tee "results/cartesian_newtonian_limit_${PBS_JOBID:-local}.txt"
echo "=== Done at $(date) ==="
