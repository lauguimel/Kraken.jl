#!/bin/bash -l
#PBS -N kraken_wi_sweep
#PBS -l select=1:ncpus=8:mem=32GB:ngpus=1:gpu_id=H100
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -m n

cd $PBS_O_WORKDIR

# --- Variables ---
JULIA_NUM_THREADS="1"
KRAKEN_BACKEND="cuda"
RESULTS_DIR="results"

# --- Pre-flight checks ---
mkdir -p $RESULTS_DIR

# --- Pre-flight GPU check ---
nvidia-smi || { echo "ERROR: GPU not available"; exit 1; }

# --- Julia environment ---
export PATH="$HOME/.juliaup/bin:$PATH"
export JULIA_CUDA_USE_COMPAT=false
julia --project=. -e 'using Pkg; Pkg.instantiate()'

# --- CUDA pre-flight (Julia) ---
julia --project=. -e '
    using CUDA
    @assert CUDA.functional() "CUDA not functional!"
    println("CUDA OK: ", CUDA.name(CUDA.device()))
    println("VRAM: ", round(CUDA.totalmem(CUDA.device()) / 1e9, digits=1), " GB")
' 2>&1 || { echo "CUDA check failed — aborting"; exit 1; }

# --- Run ---
julia --project=. hpc/sweep_wi_cylinder.jl 2>&1 | tee "$RESULTS_DIR/sweep_wi_cylinder_$(date +%Y%m%d_%H%M).txt"

